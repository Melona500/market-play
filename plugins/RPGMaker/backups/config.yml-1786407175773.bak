        choice-1: 단골 등록
        response-pages-1:
        - |-
          등록됐습니다! 이제 단골 상품을
          구매할 수 있습니다.
        response-portrait-1:
          '0': MALE_INNKEEPER
        response-expression-1:
          '0': HAPPY
        response-effects-1:
          '0':
            variables-set: shop_member=yes
            sounds: minecraft:entity.villager.yes:1.0:0.8:1
            items: minecraft:emerald:5:신규 단골 쿠폰:#55FF55
            message: 단골 등록 완료! 구매 선택지가 열렸습니다.
            message-color: '#55FF55'
        end-1: false
        choice-2: 그냥 둘러보기
        response-pages-2:
        - 천천히 둘러보세요.
        response-portrait-2:
          '0': MALE_INNKEEPER
