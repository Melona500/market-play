# ============================================================
# RPG 서버 관리 Skript
# ============================================================
#
# 기존 rpg-server-admin-plugin의 /serveradmin 명령을 감싸서
# 운영 중 자주 사용하는 서버 설정을 한 명령으로 관리합니다.
# 실제 월드 설정 변경은 기존 플러그인이 담당하므로 동작이 이중화되지 않습니다.
#
# 사용법
#   /servermanage
#   /servermanage <pvp|mob|time|weather> <on|off>
#   /servermanage save
#
# 권한
#   rpgserveradmin.use

function servermanage_help(player: player):
    send "&6[서버 관리]" to {_player}
    send "&e/servermanage <pvp|mob|time|weather> <on|off>" to {_player}
    send "&e/servermanage save &7- 월드 데이터를 즉시 저장" to {_player}

command /servermanage [<text>] [<text>]:
    permission: rpgserveradmin.use
    permission message: &c서버 관리 권한이 필요합니다.
    trigger:
        if arg-1 is not set:
            servermanage_help(player)
            stop

        if arg-1 is "save":
            execute console command "save-all flush"
            send "&a월드 데이터를 저장했습니다."
            stop

        if arg-1 is not "pvp" and arg-1 is not "mob" and arg-1 is not "time" and arg-1 is not "weather":
            send "&c알 수 없는 관리 항목입니다."
            servermanage_help(player)
            stop

        if arg-2 is not set:
            send "&cON 또는 OFF를 입력하세요."
            servermanage_help(player)
            stop

        if arg-2 is not "on" and arg-2 is not "off":
            send "&cON 또는 OFF만 사용할 수 있습니다."
            stop

        execute console command "serveradmin %arg-1% %arg-2%"
        send "&a서버 설정 변경을 적용했습니다: &f%arg-1% = %arg-2%"
